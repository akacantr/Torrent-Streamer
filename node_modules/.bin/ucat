#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.deno/utp-native@2.5.3/node_modules/utp-native/ucat.js" "$@"
else
  exec node  "$basedir/../.deno/utp-native@2.5.3/node_modules/utp-native/ucat.js" "$@"
fi
